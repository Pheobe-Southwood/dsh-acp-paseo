{
  "name": "dsh-acp-paseo",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project dsh-acp-plus --project paseo-provider --project contract",
    "test:integration": "pnpm --filter @ds-hu/dsh-acp-plus build && pnpm --filter @ds-hu/dsh-acp-plus test:integration",
    "e2e:paseo": "bash scripts/e2e-paseo.sh",
    "sync:npm-readme": "node scripts/sync-npm-readme.mjs",
    "clean": "rm -rf packages/*/dist .tmp"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "ajv": "^8.17.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
